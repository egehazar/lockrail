# Database
DATABASE_URL=postgresql+psycopg://lockrail:lockrail@localhost:5432/lockrail
REDIS_URL=redis://localhost:6379/0

# LLM providers (for eval agents)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=lockrail

# Lockrail runtime
LOCKRAIL_ENV=dev
LOCKRAIL_IDEMPOTENCY_TTL_SECONDS=86400
LOCKRAIL_APPROVAL_TIMEOUT_SECONDS=3600
LOCKRAIL_DRY_RUN_ENABLED=true
LOCKRAIL_LOG_LEVEL=INFO
